<UserControl x:Class="InvenTrack.Views.ScannerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:models="clr-namespace:InvenTrack.Models">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="380"/>
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Column="0" Margin="0,0,16,0">
            <Border Style="{StaticResource CardStyle}" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="Simulador de Captura Automática" FontSize="18" FontWeight="SemiBold"
                               Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,16"/>

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                        <TextBlock Text="Tipo de captura:" VerticalAlignment="Center"
                                   Margin="0,0,12,0" FontWeight="SemiBold"/>
                        <RadioButton Content="📊 Código de Barras" IsChecked="True" GroupName="ScanType"
                                     Margin="0,0,16,0" FontSize="13" VerticalAlignment="Center"
                                     Checked="ScanType_Barcode"/>
                        <RadioButton Content="📱 Código QR" GroupName="ScanType"
                                     Margin="0,0,16,0" FontSize="13" VerticalAlignment="Center"
                                     Checked="ScanType_QR"/>
                        <RadioButton Content="📡 RFID" GroupName="ScanType"
                                     FontSize="13" VerticalAlignment="Center"
                                     Checked="ScanType_RFID"/>
                    </StackPanel>

                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBox Grid.Column="0" Text="{Binding ManualScanValue, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource TextBoxStyle}" Margin="0,0,8,0"
                                 KeyDown="ManualScanValue_KeyDown"/>
                        <Button Grid.Column="1" Content="🔍 Buscar"
                                Command="{Binding ManualScanCommand}"
                                Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,8,0"/>
                        <Button Grid.Column="2" Content="📡 Simular Escaneo"
                                Command="{Binding SimulateScanCommand}"
                                Style="{StaticResource PrimaryButtonStyle}"/>
                    </Grid>

                    <Border CornerRadius="6" Padding="12,10"
                            Visibility="{Binding ScanStatusMessage, Converter={StaticResource BoolToVisibilityConverter}}">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="#E74C3C"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ScanStatusSuccess}" Value="True">
                                        <Setter Property="Background" Value="#2ECC71"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock Text="{Binding ScanStatusMessage}" Foreground="White" FontWeight="SemiBold"/>
                    </Border>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardStyle}"
                    Visibility="{Binding HasScannedProduct, Converter={StaticResource BoolToVisibilityConverter}}">
                <StackPanel>
                    <TextBlock Text="Producto Detectado" FontSize="16" FontWeight="SemiBold"
                               Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,12"/>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,0,10">
                            <TextBlock Text="Código" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"/>
                            <TextBlock Text="{Binding ScannedProduct.Code}" FontSize="15" FontWeight="SemiBold"/>
                        </StackPanel>
                        <StackPanel Grid.Row="0" Grid.Column="1" Margin="0,0,0,10">
                            <TextBlock Text="Nombre" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"/>
                            <TextBlock Text="{Binding ScannedProduct.Name}" FontSize="15" FontWeight="SemiBold"/>
                        </StackPanel>
                        <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,0,10">
                            <TextBlock Text="Stock Actual" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"/>
                            <TextBlock Text="{Binding ScannedProduct.CurrentStock}" FontSize="22" FontWeight="Bold"
                                       Foreground="{StaticResource AccentBrush}"/>
                        </StackPanel>
                        <StackPanel Grid.Row="1" Grid.Column="1" Margin="0,0,0,10">
                            <TextBlock Text="Precio Unitario" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"/>
                            <TextBlock Text="{Binding ScannedProduct.UnitPrice, StringFormat='S/ {0:N2}'}" FontSize="15"/>
                        </StackPanel>

                        <StackPanel Grid.Row="2" Grid.ColumnSpan="2" Margin="0,8,0,0">
                            <TextBlock Text="Registrar Movimiento" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,10"/>
                            <StackPanel Orientation="Horizontal">
                                <StackPanel Margin="0,0,16,0">
                                    <TextBlock Text="Tipo" Style="{StaticResource LabelStyle}"/>
                                    <StackPanel Orientation="Horizontal">
                                        <RadioButton Content="Entrada" IsChecked="True" GroupName="MovType"
                                                     Margin="0,0,12,0" Checked="MovType_Entry"/>
                                        <RadioButton Content="Salida" GroupName="MovType"
                                                     Checked="MovType_Exit"/>
                                    </StackPanel>
                                </StackPanel>
                                <StackPanel Margin="0,0,16,0">
                                    <TextBlock Text="Cantidad" Style="{StaticResource LabelStyle}"/>
                                    <TextBox Text="{Binding Quantity}" Style="{StaticResource TextBoxStyle}" Width="80"/>
                                </StackPanel>
                                <StackPanel>
                                    <TextBlock Text="Almacén" Style="{StaticResource LabelStyle}"/>
                                    <ComboBox ItemsSource="{Binding Warehouses}"
                                              SelectedItem="{Binding SelectedWarehouse}"
                                              DisplayMemberPath="Name"
                                              Style="{StaticResource ComboBoxStyle}" Width="180"/>
                                </StackPanel>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                <Button Content="✅ Registrar Movimiento"
                                        Command="{Binding RegisterMovementCommand}"
                                        Style="{StaticResource PrimaryButtonStyle}" Margin="0,0,8,0"/>
                                <Button Content="🔄 Limpiar"
                                        Command="{Binding ClearCommand}"
                                        Style="{StaticResource SecondaryButtonStyle}"/>
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>
        </StackPanel>

        <Border Grid.Column="1" Style="{StaticResource CardStyle}">
            <StackPanel>
                <TextBlock Text="📋 Historial de Escaneos" FontSize="16" FontWeight="SemiBold"
                           Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,12"/>
                <ItemsControl ItemsSource="{Binding ScanHistory}" MaxHeight="500">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1"
                                    Padding="8,8" Margin="0,0,0,4">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding ScanType}" FontWeight="SemiBold"
                                                   FontSize="11" Foreground="{StaticResource AccentBrush}" Margin="0,0,8,0"/>
                                        <TextBlock Text="{Binding Timestamp, StringFormat='HH:mm:ss'}"
                                                   FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"/>
                                    </StackPanel>
                                    <TextBlock Text="{Binding ScanValue}" FontSize="13" FontFamily="Consolas"/>
                                    <TextBlock Text="{Binding StatusText}" FontSize="11"
                                               Foreground="{StaticResource TextSecondaryBrush}"/>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
