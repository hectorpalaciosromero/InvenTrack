<UserControl x:Class="InvenTrack.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel>

            <!-- KPI Cards Row 1: Inventory Overview -->
            <UniformGrid Rows="1" Margin="0,0,0,16">
                <Border Style="{StaticResource CardStyle}" Margin="0,0,8,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Total Productos" FontSize="13"
                                       Foreground="{StaticResource TextSecondaryBrush}"/>
                            <TextBlock Text="{Binding TotalProducts}" FontSize="32" FontWeight="Bold"
                                       Foreground="{StaticResource TextPrimaryBrush}" Margin="0,4,0,0"/>
                            <TextBlock Text="productos activos" FontSize="11"
                                       Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2,0,0"/>
                        </StackPanel>
                        <Border Grid.Column="1" VerticalAlignment="Top"
                                Background="#EBF8FF" CornerRadius="8" Padding="10">
                            <TextBlock Text="📦" FontSize="24"/>
                        </Border>
                    </Grid>
                </Border>

                <Border Style="{StaticResource CardStyle}" Margin="8,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Stock Bajo" FontSize="13"
                                       Foreground="{StaticResource TextSecondaryBrush}"/>
                            <TextBlock Text="{Binding LowStockProducts}" FontSize="32" FontWeight="Bold"
                                       Foreground="{StaticResource WarningBrush}" Margin="0,4,0,0"/>
                            <TextBlock Text="requieren reposición" FontSize="11"
                                       Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2,0,0"/>
                        </StackPanel>
                        <Border Grid.Column="1" VerticalAlignment="Top"
                                Background="#FFF8E1" CornerRadius="8" Padding="10">
                            <TextBlock Text="⚠️" FontSize="24"/>
                        </Border>
                    </Grid>
                </Border>

                <Border Style="{StaticResource CardStyle}" Margin="8,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Sin Stock" FontSize="13"
                                       Foreground="{StaticResource TextSecondaryBrush}"/>
                            <TextBlock Text="{Binding OutOfStockProducts}" FontSize="32" FontWeight="Bold"
                                       Foreground="{StaticResource DangerBrush}" Margin="0,4,0,0"/>
                            <TextBlock Text="agotados" FontSize="11"
                                       Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2,0,0"/>
                        </StackPanel>
                        <Border Grid.Column="1" VerticalAlignment="Top"
                                Background="#FFEBEE" CornerRadius="8" Padding="10">
                            <TextBlock Text="🚫" FontSize="24"/>
                        </Border>
                    </Grid>
                </Border>

                <Border Style="{StaticResource CardStyle}" Margin="8,0,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Valor del Inventario" FontSize="13"
                                       Foreground="{StaticResource TextSecondaryBrush}"/>
                            <TextBlock Text="{Binding TotalInventoryValue, StringFormat='S/ {0:N2}'}"
                                       FontSize="24" FontWeight="Bold"
                                       Foreground="{StaticResource SuccessBrush}" Margin="0,4,0,0"/>
                            <TextBlock Text="valor total en soles" FontSize="11"
                                       Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2,0,0"/>
                        </StackPanel>
                        <Border Grid.Column="1" VerticalAlignment="Top"
                                Background="#E8F5E9" CornerRadius="8" Padding="10">
                            <TextBlock Text="💰" FontSize="24"/>
                        </Border>
                    </Grid>
                </Border>
            </UniformGrid>

            <!-- KPI Cards Row 2: Today's Activity -->
            <UniformGrid Rows="1" Columns="3" Margin="0,0,0,20">
                <Border Margin="0,0,8,0" CornerRadius="8" Padding="16"
                        BorderBrush="{StaticResource AccentBrush}" BorderThickness="0,0,0,3"
                        Background="White">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="10" ShadowDepth="2" Opacity="0.08" Color="Black"/>
                    </Border.Effect>
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="Movimientos Hoy" FontSize="13" HorizontalAlignment="Center"
                                   Foreground="{StaticResource TextSecondaryBrush}"/>
                        <TextBlock Text="{Binding TotalMovementsToday}" FontSize="36" FontWeight="Bold"
                                   HorizontalAlignment="Center"
                                   Foreground="{StaticResource AccentBrush}" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>

                <Border Margin="8,0" CornerRadius="8" Padding="16"
                        BorderBrush="{StaticResource SuccessBrush}" BorderThickness="0,0,0,3"
                        Background="White">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="10" ShadowDepth="2" Opacity="0.08" Color="Black"/>
                    </Border.Effect>
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="📥 Entradas Hoy" FontSize="13" HorizontalAlignment="Center"
                                   Foreground="{StaticResource TextSecondaryBrush}"/>
                        <TextBlock Text="{Binding EntriesToday}" FontSize="36" FontWeight="Bold"
                                   HorizontalAlignment="Center"
                                   Foreground="{StaticResource SuccessBrush}" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>

                <Border Margin="8,0,0,0" CornerRadius="8" Padding="16"
                        BorderBrush="{StaticResource DangerBrush}" BorderThickness="0,0,0,3"
                        Background="White">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="10" ShadowDepth="2" Opacity="0.08" Color="Black"/>
                    </Border.Effect>
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="📤 Salidas Hoy" FontSize="13" HorizontalAlignment="Center"
                                   Foreground="{StaticResource TextSecondaryBrush}"/>
                        <TextBlock Text="{Binding ExitsToday}" FontSize="36" FontWeight="Bold"
                                   HorizontalAlignment="Center"
                                   Foreground="{StaticResource DangerBrush}" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>
            </UniformGrid>

            <!-- Bottom Section: Alerts + Recent Movements -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource CardStyle}" Margin="0,0,10,0">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                            <Border Background="#FFEBEE" CornerRadius="4" Padding="6,3" Margin="0,0,8,0">
                                <TextBlock Text="⚠️" FontSize="14"/>
                            </Border>
                            <TextBlock Text="Alertas de Stock Bajo" FontSize="16" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                        </StackPanel>
                        <DataGrid ItemsSource="{Binding LowStockItems}" Style="{StaticResource DataGridStyle}"
                                  MaxHeight="280">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Código" Binding="{Binding Code}" Width="90"/>
                                <DataGridTextColumn Header="Producto" Binding="{Binding Name}" Width="*"/>
                                <DataGridTextColumn Header="Stock" Binding="{Binding CurrentStock}" Width="60"/>
                                <DataGridTextColumn Header="Mín." Binding="{Binding MinimumStock}" Width="50"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </Border>

                <Border Grid.Column="1" Style="{StaticResource CardStyle}" Margin="10,0,0,0">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                            <Border Background="#EBF8FF" CornerRadius="4" Padding="6,3" Margin="0,0,8,0">
                                <TextBlock Text="🕐" FontSize="14"/>
                            </Border>
                            <TextBlock Text="Movimientos Recientes" FontSize="16" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                        </StackPanel>
                        <DataGrid ItemsSource="{Binding RecentMovements}" Style="{StaticResource DataGridStyle}"
                                  MaxHeight="280">
                            <DataGrid.Columns>
                                <DataGridTemplateColumn Header="Tipo" Width="80" SortMemberPath="Type">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border CornerRadius="4" Padding="6,2" HorizontalAlignment="Left">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Type}" Value="1">
                                                                <Setter Property="Background" Value="#D5F5E3"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Type}" Value="2">
                                                                <Setter Property="Background" Value="#FADBD8"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <TextBlock FontSize="11" FontWeight="SemiBold">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Type}" Value="1">
                                                                    <Setter Property="Text" Value="📥 Entrada"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding Type}" Value="2">
                                                                    <Setter Property="Text" Value="📤 Salida"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding Type}" Value="4">
                                                                    <Setter Property="Text" Value="⚙️ Ajuste"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="Producto" Binding="{Binding ProductName}" Width="*"/>
                                <DataGridTextColumn Header="Cant." Binding="{Binding Quantity}" Width="50"/>
                                <DataGridTextColumn Header="Fecha" Binding="{Binding CreatedAt, StringFormat='dd/MM HH:mm'}" Width="85"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Quick Actions -->
            <Border Style="{StaticResource CardStyle}" Margin="0,16,0,0">
                <StackPanel>
                    <TextBlock Text="Acciones Rápidas" FontSize="16" FontWeight="SemiBold"
                               Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,12"/>
                    <StackPanel Orientation="Horizontal">
                        <Button Content="📦 Ir a Productos" Command="{Binding NavigateToProductsCommand}"
                                Style="{StaticResource PrimaryButtonStyle}" Margin="0,0,12,0"/>
                        <Button Content="📡 Abrir Escáner" Command="{Binding NavigateToScannerCommand}"
                                Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,12,0"/>
                        <Button Content="🔄 Actualizar" Command="{Binding RefreshCommand}"
                                Style="{StaticResource SecondaryButtonStyle}"/>
                    </StackPanel>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
