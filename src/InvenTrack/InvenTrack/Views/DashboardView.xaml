<UserControl x:Class="InvenTrack.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <StackPanel>
        <UniformGrid Rows="1" Margin="0,0,0,20">
            <Border Style="{StaticResource CardStyle}" Margin="0,0,10,0">
                <StackPanel>
                    <TextBlock Text="📦 Total Productos" Style="{StaticResource SubheadingStyle}"/>
                    <TextBlock Text="{Binding TotalProducts}" FontSize="36" FontWeight="Bold"
                               Foreground="{StaticResource AccentBrush}" Margin="0,8,0,0"/>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource CardStyle}" Margin="5,0">
                <StackPanel>
                    <TextBlock Text="⚠️ Stock Bajo" Style="{StaticResource SubheadingStyle}"/>
                    <TextBlock Text="{Binding LowStockProducts}" FontSize="36" FontWeight="Bold"
                               Foreground="{StaticResource WarningBrush}" Margin="0,8,0,0"/>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource CardStyle}" Margin="5,0">
                <StackPanel>
                    <TextBlock Text="🚫 Sin Stock" Style="{StaticResource SubheadingStyle}"/>
                    <TextBlock Text="{Binding OutOfStockProducts}" FontSize="36" FontWeight="Bold"
                               Foreground="{StaticResource DangerBrush}" Margin="0,8,0,0"/>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource CardStyle}" Margin="10,0,0,0">
                <StackPanel>
                    <TextBlock Text="💰 Valor Total" Style="{StaticResource SubheadingStyle}"/>
                    <TextBlock Text="{Binding TotalInventoryValue, StringFormat='S/ {0:N2}'}"
                               FontSize="28" FontWeight="Bold"
                               Foreground="{StaticResource SuccessBrush}" Margin="0,8,0,0"/>
                </StackPanel>
            </Border>
        </UniformGrid>

        <UniformGrid Rows="1" Margin="0,0,0,20">
            <Border Style="{StaticResource CardStyle}" Margin="0,0,10,0">
                <StackPanel>
                    <TextBlock Text="🔄 Movimientos Hoy" Style="{StaticResource SubheadingStyle}"/>
                    <TextBlock Text="{Binding TotalMovementsToday}" FontSize="36" FontWeight="Bold"
                               Foreground="{StaticResource TextPrimaryBrush}" Margin="0,8,0,0"/>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource CardStyle}" Margin="5,0">
                <StackPanel>
                    <TextBlock Text="📥 Entradas Hoy" Style="{StaticResource SubheadingStyle}"/>
                    <TextBlock Text="{Binding EntriesToday}" FontSize="36" FontWeight="Bold"
                               Foreground="{StaticResource SuccessBrush}" Margin="0,8,0,0"/>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource CardStyle}" Margin="10,0,0,0">
                <StackPanel>
                    <TextBlock Text="📤 Salidas Hoy" Style="{StaticResource SubheadingStyle}"/>
                    <TextBlock Text="{Binding ExitsToday}" FontSize="36" FontWeight="Bold"
                               Foreground="{StaticResource DangerBrush}" Margin="0,8,0,0"/>
                </StackPanel>
            </Border>
        </UniformGrid>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource CardStyle}" Margin="0,0,10,0">
                <StackPanel>
                    <TextBlock Text="⚠️ Alertas de Stock Bajo" FontSize="16" FontWeight="SemiBold"
                               Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,12"/>
                    <DataGrid ItemsSource="{Binding LowStockItems}" Style="{StaticResource DataGridStyle}"
                              MaxHeight="250">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Código" Binding="{Binding Code}" Width="90"/>
                            <DataGridTextColumn Header="Producto" Binding="{Binding Name}" Width="*"/>
                            <DataGridTextColumn Header="Stock" Binding="{Binding CurrentStock}" Width="60"/>
                            <DataGridTextColumn Header="Mín." Binding="{Binding MinimumStock}" Width="50"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </StackPanel>
            </Border>

            <Border Grid.Column="1" Style="{StaticResource CardStyle}" Margin="10,0,0,0">
                <StackPanel>
                    <TextBlock Text="🕐 Movimientos Recientes" FontSize="16" FontWeight="SemiBold"
                               Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,12"/>
                    <DataGrid ItemsSource="{Binding RecentMovements}" Style="{StaticResource DataGridStyle}"
                              MaxHeight="250">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Producto" Binding="{Binding ProductName}" Width="*"/>
                            <DataGridTextColumn Header="Cant." Binding="{Binding Quantity}" Width="55"/>
                            <DataGridTextColumn Header="Método" Binding="{Binding CaptureMethod}" Width="75"/>
                            <DataGridTextColumn Header="Fecha" Binding="{Binding CreatedAt, StringFormat='dd/MM HH:mm'}" Width="90"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </StackPanel>
            </Border>
        </Grid>
    </StackPanel>
</UserControl>
