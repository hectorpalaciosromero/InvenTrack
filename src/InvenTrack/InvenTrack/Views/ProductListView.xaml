<UserControl x:Class="InvenTrack.Views.ProductListView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <StackPanel>
        <Border Style="{StaticResource CardStyle}" Margin="0,0,0,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="200"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBox Grid.Column="0" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                         Style="{StaticResource TextBoxStyle}" Margin="0,0,12,0">
                    <TextBox.Tag>Buscar por código o nombre...</TextBox.Tag>
                </TextBox>

                <ComboBox Grid.Column="1" ItemsSource="{Binding Categories}"
                          SelectedItem="{Binding SelectedCategory}"
                          DisplayMemberPath="Name"
                          Style="{StaticResource ComboBoxStyle}" Margin="0,0,12,0"/>

                <Button Grid.Column="2" Content="🔄 Limpiar"
                        Command="{Binding ClearFilterCommand}"
                        Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,8,0"/>

                <Button Grid.Column="3" Content="➕ Nuevo Producto"
                        Command="{Binding AddCommand}"
                        Style="{StaticResource PrimaryButtonStyle}"/>
            </Grid>
        </Border>

        <Border Style="{StaticResource CardStyle}">
            <DataGrid ItemsSource="{Binding Products}"
                      SelectedItem="{Binding SelectedProduct}"
                      Style="{StaticResource DataGridStyle}"
                      MinHeight="400">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Código" Binding="{Binding Code}" Width="100"/>
                    <DataGridTextColumn Header="Nombre" Binding="{Binding Name}" Width="*"/>
                    <DataGridTextColumn Header="Categoría" Binding="{Binding CategoryName}" Width="130"/>
                    <DataGridTextColumn Header="Precio" Binding="{Binding UnitPrice, StringFormat='S/ {0:N2}'}" Width="100"/>
                    <DataGridTextColumn Header="Stock" Binding="{Binding CurrentStock}" Width="70"/>
                    <DataGridTextColumn Header="Mín." Binding="{Binding MinimumStock}" Width="60"/>
                    <DataGridTextColumn Header="Unidad" Binding="{Binding Unit}" Width="65"/>
                    <DataGridTextColumn Header="Barcode" Binding="{Binding Barcode}" Width="120"/>
                    <DataGridTextColumn Header="RFID" Binding="{Binding RFIDTag}" Width="120"/>
                    <DataGridTemplateColumn Header="Acciones" Width="140">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <Button Content="✏️" ToolTip="Editar"
                                            Command="{Binding DataContext.EditCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            Background="Transparent" BorderThickness="0"
                                            FontSize="16" Cursor="Hand" Padding="6,2"/>
                                    <Button Content="🗑️" ToolTip="Eliminar"
                                            Command="{Binding DataContext.DeleteCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            Background="Transparent" BorderThickness="0"
                                            FontSize="16" Cursor="Hand" Padding="6,2"/>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </StackPanel>
</UserControl>
