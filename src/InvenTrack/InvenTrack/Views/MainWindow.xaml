<Window x:Class="InvenTrack.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:InvenTrack.ViewModels"
        Title="InvenTrack - Sistema de Gestión de Inventario"
        Width="1280" Height="750"
        MinWidth="1024" MinHeight="600"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized"
        Background="{StaticResource BackgroundBrush}">

    <Window.DataContext>
        <vm:MainViewModel/>
    </Window.DataContext>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="240"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="{StaticResource SidebarBrush}">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Margin="0,20,0,20">
                    <TextBlock Text="📦" FontSize="28" HorizontalAlignment="Center" Margin="0,0,0,4"/>
                    <TextBlock Text="InvenTrack" FontSize="20" FontWeight="Bold"
                               Foreground="White" HorizontalAlignment="Center"/>
                    <TextBlock Text="Gestión de Inventario" FontSize="11"
                               Foreground="#7A8BB5" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                </StackPanel>

                <Border DockPanel.Dock="Top" Height="1" Background="#2D4373" Margin="16,0"/>

                <StackPanel DockPanel.Dock="Bottom" Margin="16,16">
                    <Border Background="#2D4373" CornerRadius="8" Padding="12,10" Margin="0,0,0,8">
                        <StackPanel>
                            <TextBlock Text="{Binding UserDisplayName}" Foreground="White"
                                       FontSize="13" FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding UserRole}" Foreground="#7A8BB5" FontSize="11"/>
                        </StackPanel>
                    </Border>
                    <Button Content="🚪 Cerrar Sesión"
                            Command="{Binding LogoutCommand}"
                            Foreground="#AAB8D2" Background="Transparent"
                            BorderThickness="0" Cursor="Hand" FontSize="13"
                            HorizontalAlignment="Left" Padding="4"/>
                </StackPanel>

                <StackPanel Margin="0,16,0,0">
                    <RadioButton Content="Dashboard" Tag="📊"
                                 Style="{StaticResource SidebarButtonStyle}"
                                 IsChecked="{Binding IsDashboard, Mode=OneWay}"
                                 Command="{Binding NavigateCommand}" CommandParameter="Dashboard"/>

                    <RadioButton Content="Productos" Tag="📦"
                                 Style="{StaticResource SidebarButtonStyle}"
                                 IsChecked="{Binding IsProducts, Mode=OneWay}"
                                 Command="{Binding NavigateCommand}" CommandParameter="Products"/>

                    <RadioButton Content="Simulador Captura" Tag="📡"
                                 Style="{StaticResource SidebarButtonStyle}"
                                 IsChecked="{Binding IsScanner, Mode=OneWay}"
                                 Command="{Binding NavigateCommand}" CommandParameter="Scanner"/>

                    <RadioButton Content="Movimientos" Tag="🔄"
                                 Style="{StaticResource SidebarButtonStyle}"
                                 IsChecked="{Binding IsMovements, Mode=OneWay}"
                                 Command="{Binding NavigateCommand}" CommandParameter="Movements"/>

                    <RadioButton Content="Reportes" Tag="📋"
                                 Style="{StaticResource SidebarButtonStyle}"
                                 IsChecked="{Binding IsReports, Mode=OneWay}"
                                 Command="{Binding NavigateCommand}" CommandParameter="Reports"/>

                    <RadioButton Content="Usuarios" Tag="👥"
                                 Style="{StaticResource SidebarButtonStyle}"
                                 IsChecked="{Binding IsUsers, Mode=OneWay}"
                                 Command="{Binding NavigateCommand}" CommandParameter="Users"
                                 Visibility="{Binding IsAdmin, Converter={StaticResource BoolToVisibilityConverter}}"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <DockPanel Grid.Column="1">
            <Border DockPanel.Dock="Top" Background="White" Padding="24,16"
                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
                <Grid>
                    <TextBlock Text="{Binding CurrentViewTitle}"
                               Style="{StaticResource HeadingStyle}" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding Source={x:Static System:DateTime.Now}, StringFormat='dddd, dd MMMM yyyy'}"
                               HorizontalAlignment="Right" VerticalAlignment="Center"
                               Foreground="{StaticResource TextSecondaryBrush}" FontSize="13"
                               xmlns:System="clr-namespace:System;assembly=mscorlib"/>
                </Grid>
            </Border>

            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="24,20">
                <ContentControl Content="{Binding CurrentView}"/>
            </ScrollViewer>
        </DockPanel>
    </Grid>
</Window>
