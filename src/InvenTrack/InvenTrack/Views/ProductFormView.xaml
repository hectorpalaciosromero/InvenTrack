<UserControl x:Class="InvenTrack.Views.ProductFormView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Border Style="{StaticResource CardStyle}" MaxWidth="700" HorizontalAlignment="Left">
        <StackPanel>
            <TextBlock Text="{Binding FormTitle}" FontSize="20" FontWeight="Bold"
                       Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,20"/>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,10,16">
                    <TextBlock Text="Código *" Style="{StaticResource LabelStyle}"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox Text="{Binding Code}" Style="{StaticResource TextBoxStyle}"/>
                        <Button Grid.Column="1" Content="⚡" ToolTip="Generar código"
                                Command="{Binding GenerateCodeCommand}"
                                Background="Transparent" BorderThickness="0"
                                FontSize="18" Cursor="Hand" Margin="4,0,0,0"/>
                    </Grid>
                </StackPanel>

                <StackPanel Grid.Row="0" Grid.Column="1" Margin="10,0,0,16">
                    <TextBlock Text="Categoría *" Style="{StaticResource LabelStyle}"/>
                    <ComboBox ItemsSource="{Binding Categories}"
                              SelectedItem="{Binding SelectedCategory}"
                              DisplayMemberPath="Name"
                              Style="{StaticResource ComboBoxStyle}"/>
                </StackPanel>

                <StackPanel Grid.Row="1" Grid.ColumnSpan="2" Margin="0,0,0,16">
                    <TextBlock Text="Nombre *" Style="{StaticResource LabelStyle}"/>
                    <TextBox Text="{Binding Name}" Style="{StaticResource TextBoxStyle}"/>
                </StackPanel>

                <StackPanel Grid.Row="2" Grid.ColumnSpan="2" Margin="0,0,0,16">
                    <TextBlock Text="Descripción" Style="{StaticResource LabelStyle}"/>
                    <TextBox Text="{Binding Description}" Style="{StaticResource TextBoxStyle}"
                             TextWrapping="Wrap" AcceptsReturn="True" Height="60"/>
                </StackPanel>

                <StackPanel Grid.Row="3" Grid.Column="0" Margin="0,0,10,16">
                    <TextBlock Text="Precio Unitario" Style="{StaticResource LabelStyle}"/>
                    <TextBox Text="{Binding UnitPrice, StringFormat='N2'}" Style="{StaticResource TextBoxStyle}"/>
                </StackPanel>

                <StackPanel Grid.Row="3" Grid.Column="1" Margin="10,0,0,16">
                    <TextBlock Text="Unidad" Style="{StaticResource LabelStyle}"/>
                    <TextBox Text="{Binding Unit}" Style="{StaticResource TextBoxStyle}"/>
                </StackPanel>

                <StackPanel Grid.Row="4" Grid.Column="0" Margin="0,0,10,16"
                            Visibility="{Binding ShowStockField, Converter={StaticResource BoolToVisibilityConverter}}">
                    <TextBlock Text="Stock Inicial" Style="{StaticResource LabelStyle}"/>
                    <TextBox Text="{Binding CurrentStock}" Style="{StaticResource TextBoxStyle}"/>
                </StackPanel>

                <StackPanel Grid.Row="4" Grid.Column="1" Margin="10,0,0,16">
                    <TextBlock Text="Stock Mínimo" Style="{StaticResource LabelStyle}"/>
                    <TextBox Text="{Binding MinimumStock}" Style="{StaticResource TextBoxStyle}"/>
                </StackPanel>

                <TextBlock Grid.Row="5" Grid.ColumnSpan="2" Text="Identificadores de Captura Automática"
                           FontSize="15" FontWeight="SemiBold" Margin="0,8,0,12"
                           Foreground="{StaticResource TextPrimaryBrush}"/>

                <StackPanel Grid.Row="6" Grid.ColumnSpan="2">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Margin="0,0,8,0">
                            <TextBlock Text="Código de Barras" Style="{StaticResource LabelStyle}"/>
                            <TextBox Text="{Binding Barcode}" Style="{StaticResource TextBoxStyle}"/>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Margin="4,0">
                            <TextBlock Text="Código QR" Style="{StaticResource LabelStyle}"/>
                            <TextBox Text="{Binding QRCode}" Style="{StaticResource TextBoxStyle}"/>
                        </StackPanel>

                        <StackPanel Grid.Column="2" Margin="8,0,0,0">
                            <TextBlock Text="Tag RFID" Style="{StaticResource LabelStyle}"/>
                            <TextBox Text="{Binding RFIDTag}" Style="{StaticResource TextBoxStyle}"/>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Grid>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,24,0,0">
                <Button Content="Cancelar" Command="{Binding CancelCommand}"
                        Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,12,0"/>
                <Button Content="💾 Guardar" Command="{Binding SaveCommand}"
                        Style="{StaticResource PrimaryButtonStyle}"/>
            </StackPanel>
        </StackPanel>
    </Border>
</UserControl>
