<UserControl x:Class="InvenTrack.Views.ProductFormView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="420"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Style="{StaticResource CardStyle}" Margin="0,0,16,0" VerticalAlignment="Top">
            <StackPanel>
                <TextBlock Text="{Binding FormTitle}" FontSize="20" FontWeight="Bold"
                           Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,20"/>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,10,16">
                        <TextBlock Text="Código *" Style="{StaticResource LabelStyle}"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Text="{Binding Code, UpdateSourceTrigger=PropertyChanged}"
                                     MaxLength="30"
                                     Tag="Ej: PROD-001"
                                     Style="{StaticResource TextBoxStyle}"/>
                            <Button Grid.Column="1" Content="⚡" ToolTip="Generar código e identificadores"
                                    Command="{Binding GenerateCodeCommand}"
                                    Background="Transparent" BorderThickness="0"
                                    FontSize="18" Cursor="Hand" Margin="6,0,0,0"/>
                        </Grid>
                    </StackPanel>

                    <StackPanel Grid.Row="0" Grid.Column="1" Margin="10,0,0,16">
                        <TextBlock Text="Categoría *" Style="{StaticResource LabelStyle}"/>
                        <ComboBox ItemsSource="{Binding Categories}"
                                  SelectedItem="{Binding SelectedCategory}"
                                  DisplayMemberPath="Name"
                                  Style="{StaticResource ComboBoxStyle}"/>
                    </StackPanel>

                    <StackPanel Grid.Row="1" Grid.ColumnSpan="2" Margin="0,0,0,16">
                        <TextBlock Text="Nombre *" Style="{StaticResource LabelStyle}"/>
                        <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                                 MaxLength="200"
                                 Tag="Nombre descriptivo del producto"
                                 Style="{StaticResource TextBoxStyle}"/>
                    </StackPanel>

                    <StackPanel Grid.Row="2" Grid.ColumnSpan="2" Margin="0,0,0,16">
                        <TextBlock Text="Descripción" Style="{StaticResource LabelStyle}"/>
                        <TextBox Text="{Binding Description}"
                                 MaxLength="500"
                                 Style="{StaticResource TextBoxStyle}"
                                 TextWrapping="Wrap" AcceptsReturn="True" Height="72"
                                 VerticalContentAlignment="Top"/>
                    </StackPanel>

                    <StackPanel Grid.Row="3" Grid.Column="0" Margin="0,0,10,16">
                        <TextBlock Text="Precio Unitario (S/)" Style="{StaticResource LabelStyle}"/>
                        <TextBox Text="{Binding UnitPrice, StringFormat='N2'}"
                                 Style="{StaticResource TextBoxStyle}"/>
                    </StackPanel>

                    <StackPanel Grid.Row="3" Grid.Column="1" Margin="10,0,0,16">
                        <TextBlock Text="Unidad *" Style="{StaticResource LabelStyle}"/>
                        <TextBox Text="{Binding Unit}"
                                 MaxLength="10"
                                 Tag="UND, ROL, CAJ..."
                                 Style="{StaticResource TextBoxStyle}"/>
                    </StackPanel>

                    <StackPanel Grid.Row="4" Grid.Column="0" Margin="0,0,10,0">
                        <TextBlock Text="{Binding StockFieldLabel}" Style="{StaticResource LabelStyle}"/>
                        <TextBox Text="{Binding CurrentStock}"
                                 IsReadOnly="{Binding IsEditing}"
                                 ToolTip="En edición, el stock solo se modifica mediante movimientos de almacén"
                                 Style="{StaticResource TextBoxStyle}"/>
                    </StackPanel>

                    <StackPanel Grid.Row="4" Grid.Column="1" Margin="10,0,0,0">
                        <TextBlock Text="Stock Mínimo" Style="{StaticResource LabelStyle}"/>
                        <TextBox Text="{Binding MinimumStock}" Style="{StaticResource TextBoxStyle}"/>
                    </StackPanel>
                </Grid>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,24,0,0">
                    <Button Content="Cancelar" Command="{Binding CancelCommand}"
                            Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,12,0"/>
                    <Button Content="💾 Guardar" Command="{Binding SaveCommand}"
                            Style="{StaticResource PrimaryButtonStyle}"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <Border Grid.Column="1" Style="{StaticResource CardStyle}" VerticalAlignment="Top">
            <StackPanel>
                <TextBlock Text="Captura Automática" FontSize="17" FontWeight="SemiBold"
                           Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,4"/>
                <TextBlock Text="Identificadores para lectura con lector USB, QR o RFID" FontSize="12"
                           Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,16"/>

                <StackPanel Margin="0,0,0,14">
                    <TextBlock Text="Código de Barras (CODE 128)" Style="{StaticResource LabelStyle}"/>
                    <TextBox Text="{Binding Barcode, UpdateSourceTrigger=PropertyChanged}"
                             MaxLength="50"
                             Tag="Ej: 7501234567001"
                             Style="{StaticResource TextBoxStyle}"/>
                </StackPanel>

                <StackPanel Margin="0,0,0,14">
                    <TextBlock Text="Código QR" Style="{StaticResource LabelStyle}"/>
                    <TextBox Text="{Binding QRCode, UpdateSourceTrigger=PropertyChanged}"
                             MaxLength="100"
                             Tag="Ej: QR-PROD-001"
                             Style="{StaticResource TextBoxStyle}"/>
                </StackPanel>

                <StackPanel Margin="0,0,0,18">
                    <TextBlock Text="Tag RFID" Style="{StaticResource LabelStyle}"/>
                    <TextBox Text="{Binding RFIDTag}"
                             MaxLength="100"
                             Tag="Ej: RFID-TAG-001"
                             Style="{StaticResource TextBoxStyle}"/>
                </StackPanel>

                <Border Background="#F8FAFC" CornerRadius="6" Padding="14" Margin="0,0,0,12"
                        BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                        Visibility="{Binding BarcodeImage, Converter={StaticResource BoolToVisibilityConverter}}">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="Vista previa — Código de Barras" FontSize="11"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   HorizontalAlignment="Center" Margin="0,0,0,8"/>
                        <Image Source="{Binding BarcodeImage}" MaxHeight="68"
                               RenderOptions.BitmapScalingMode="NearestNeighbor"
                               Stretch="Uniform"/>
                        <TextBlock Text="{Binding Barcode}" FontSize="11" FontFamily="Consolas"
                                   HorizontalAlignment="Center" Margin="0,6,0,0"
                                   Foreground="{StaticResource TextSecondaryBrush}"/>
                    </StackPanel>
                </Border>

                <Border Background="#F8FAFC" CornerRadius="6" Padding="14"
                        BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                        Visibility="{Binding QRCodeImage, Converter={StaticResource BoolToVisibilityConverter}}">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="Vista previa — Código QR" FontSize="11"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   HorizontalAlignment="Center" Margin="0,0,0,8"/>
                        <Image Source="{Binding QRCodeImage}" MaxHeight="135" MaxWidth="135"
                               RenderOptions.BitmapScalingMode="NearestNeighbor"
                               Stretch="Uniform"/>
                        <TextBlock Text="{Binding QRCode}" FontSize="11" FontFamily="Consolas"
                                   HorizontalAlignment="Center" Margin="0,6,0,0"
                                   Foreground="{StaticResource TextSecondaryBrush}"/>
                    </StackPanel>
                </Border>

                <Border Background="#F8FAFC" CornerRadius="6" Padding="18"
                        BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                        Visibility="{Binding HasNoPreview, Converter={StaticResource BoolToVisibilityConverter}}">
                    <TextBlock Text="Ingrese un código de barras o QR, o presione ⚡ para generar la vista previa."
                               FontSize="12" TextWrapping="Wrap" TextAlignment="Center"
                               Foreground="{StaticResource TextSecondaryBrush}"/>
                </Border>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
