<UserControl x:Class="InvenTrack.Views.ReportView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <StackPanel>
        <Border Style="{StaticResource CardStyle}" Margin="0,0,0,16">
            <StackPanel>
                <TextBlock Text="Seleccione el tipo de reporte" Style="{StaticResource LabelStyle}" Margin="0,0,0,10"/>
                <StackPanel Orientation="Horizontal">
                    <RadioButton Content="📦 Stock Actual" IsChecked="True" GroupName="ReportType"
                                 Margin="0,0,20,0" FontSize="14" Cursor="Hand"
                                 Checked="Report_Stock"/>
                    <RadioButton Content="🔄 Movimientos" GroupName="ReportType"
                                 Margin="0,0,20,0" FontSize="14" Cursor="Hand"
                                 Checked="Report_Movements"/>
                    <RadioButton Content="⚠️ Stock Bajo" GroupName="ReportType"
                                 FontSize="14" Cursor="Hand"
                                 Checked="Report_LowStock"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" Margin="0,16,0,0"
                            Visibility="{Binding ShowDateRange, Converter={StaticResource BoolToVisibilityConverter}}">
                    <StackPanel Margin="0,0,16,0">
                        <TextBlock Text="Desde" Style="{StaticResource LabelStyle}"/>
                        <DatePicker SelectedDate="{Binding FromDate}" Width="140"/>
                    </StackPanel>
                    <StackPanel>
                        <TextBlock Text="Hasta" Style="{StaticResource LabelStyle}"/>
                        <DatePicker SelectedDate="{Binding ToDate}" Width="140"/>
                    </StackPanel>
                </StackPanel>

                <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                    <Button Content="📋 Generar Reporte"
                            Command="{Binding GenerateCommand}"
                            Style="{StaticResource PrimaryButtonStyle}" Margin="0,0,12,0"/>
                    <Button Content="💾 Exportar TXT"
                            Command="{Binding ExportCommand}"
                            Style="{StaticResource SecondaryButtonStyle}"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <Border Style="{StaticResource CardStyle}">
            <TextBox Text="{Binding ReportContent, Mode=OneWay}"
                     IsReadOnly="True"
                     FontFamily="Consolas"
                     FontSize="12"
                     Background="#1E293B"
                     Foreground="#E2E8F0"
                     Padding="16"
                     TextWrapping="NoWrap"
                     HorizontalScrollBarVisibility="Auto"
                     VerticalScrollBarVisibility="Auto"
                     MinHeight="400"
                     AcceptsReturn="True"
                     BorderThickness="0"/>
        </Border>
    </StackPanel>
</UserControl>
