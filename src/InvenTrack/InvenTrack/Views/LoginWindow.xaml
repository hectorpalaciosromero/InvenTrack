<Window x:Class="InvenTrack.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:InvenTrack.ViewModels"
        Title="InvenTrack - Iniciar Sesión"
        Width="420" Height="520"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize">

    <Window.DataContext>
        <vm:LoginViewModel/>
    </Window.DataContext>

    <Border Background="White" CornerRadius="12">
        <Border.Effect>
            <DropShadowEffect BlurRadius="20" ShadowDepth="4" Opacity="0.15" Color="Black"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="{StaticResource PrimaryBrush}"
                    CornerRadius="12,12,0,0" Padding="30,35">
                <StackPanel HorizontalAlignment="Center">
                    <TextBlock Text="📦" FontSize="40" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                    <TextBlock Text="InvenTrack" FontSize="26" FontWeight="Bold"
                               Foreground="White" HorizontalAlignment="Center"/>
                    <TextBlock Text="Sistema de Gestión de Inventario"
                               FontSize="12" Foreground="#AAB8D2" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                </StackPanel>
            </Border>

            <StackPanel Grid.Row="1" Margin="35,30,35,30" VerticalAlignment="Center">

                <TextBlock Text="Usuario" Style="{StaticResource LabelStyle}"/>
                <TextBox Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}"
                         Style="{StaticResource TextBoxStyle}" Margin="0,0,0,16"/>

                <TextBlock Text="Contraseña" Style="{StaticResource LabelStyle}"/>
                <PasswordBox x:Name="PasswordBox"
                             Style="{StaticResource PasswordBoxStyle}" Margin="0,0,0,8"/>

                <TextBlock Text="{Binding ErrorMessage}"
                           Foreground="{StaticResource DangerBrush}"
                           FontSize="12" Margin="0,0,0,16"
                           TextWrapping="Wrap"
                           Visibility="{Binding ErrorMessage, Converter={StaticResource BoolToVisibilityConverter}}"/>

                <Button Content="Iniciar Sesión"
                        IsDefault="True"
                        Style="{StaticResource PrimaryButtonStyle}"
                        Command="{Binding LoginCommand}"
                        CommandParameter="{Binding ElementName=PasswordBox, Path=Password}"
                        HorizontalAlignment="Stretch" Margin="0,8,0,0"
                        Height="42"/>

                <Button Content="Salir" Margin="0,12,0,0"
                        HorizontalAlignment="Center"
                        Background="Transparent" BorderThickness="0"
                        Foreground="{StaticResource TextSecondaryBrush}"
                        FontSize="13" Cursor="Hand"
                        Click="CloseButton_Click"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
